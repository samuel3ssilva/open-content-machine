{
  "additionalProperties": false,
  "description": "M4 (ADR 0004): one topic's tier admission, gate reasons, D1 exception\nand diagnostic outcome, and recommended action.\n\nDeliberately reuses ``RankingBreakdown.tier1_eligible`` and\n``eligibility_reasons`` rather than re-deriving the base Tier-1 rule --\nthis model only adds the Founder D1 exception (recorded, per the ADR, as\nmeasured-unreachable) on top. ``d1_would_admit_at_evidence_3`` is a\nDIAGNOSTIC ONLY, computed for Founder decision-support -- it never\naffects ``tier1_admitted``.",
  "properties": {
    "tier": {
      "enum": [
        "tier_1",
        "tier_2",
        "tier_3"
      ],
      "title": "Tier",
      "type": "string"
    },
    "tier_label": {
      "title": "Tier Label",
      "type": "string"
    },
    "rank": {
      "title": "Rank",
      "type": "integer"
    },
    "tier1_admitted": {
      "title": "Tier1 Admitted",
      "type": "boolean"
    },
    "admission_reasons": {
      "items": {
        "type": "string"
      },
      "title": "Admission Reasons",
      "type": "array"
    },
    "exclusion_reasons": {
      "items": {
        "type": "string"
      },
      "title": "Exclusion Reasons",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "d1_exception_fired": {
      "title": "D1 Exception Fired",
      "type": "boolean"
    },
    "d1_would_admit_at_evidence_3": {
      "title": "D1 Would Admit At Evidence 3",
      "type": "boolean"
    },
    "recommended_action": {
      "enum": [
        "study",
        "read",
        "save",
        "monitor",
        "ignore"
      ],
      "title": "Recommended Action",
      "type": "string"
    },
    "recommended_action_reason": {
      "title": "Recommended Action Reason",
      "type": "string"
    }
  },
  "required": [
    "tier",
    "tier_label",
    "rank",
    "tier1_admitted",
    "d1_exception_fired",
    "d1_would_admit_at_evidence_3",
    "recommended_action",
    "recommended_action_reason"
  ],
  "title": "TierAssignment",
  "type": "object"
}
