{
  "$defs": {
    "ContentOpportunity": {
      "additionalProperties": false,
      "description": "One topic that passed the content-opportunity editorial-gate proxy.",
      "properties": {
        "topic_id": {
          "title": "Topic Id",
          "type": "string"
        },
        "canonical_title": {
          "title": "Canonical Title",
          "type": "string"
        },
        "rank": {
          "title": "Rank",
          "type": "integer"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "topic_id",
        "canonical_title",
        "rank",
        "reason"
      ],
      "title": "ContentOpportunity",
      "type": "object"
    },
    "ContentOpportunitySelection": {
      "additionalProperties": false,
      "description": "Up to three content opportunities. Zero is a valid, stated outcome --\nnever backfilled to hit a quota.",
      "properties": {
        "selection_rule": {
          "title": "Selection Rule",
          "type": "string"
        },
        "opportunities": {
          "items": {
            "$ref": "#/$defs/ContentOpportunity"
          },
          "title": "Opportunities",
          "type": "array"
        },
        "none_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "None Reason"
        }
      },
      "required": [
        "selection_rule",
        "opportunities",
        "none_reason"
      ],
      "title": "ContentOpportunitySelection",
      "type": "object"
    },
    "DiscardedTopic": {
      "additionalProperties": false,
      "description": "One topic ranked below the Top N, with a one-line reason.",
      "properties": {
        "topic_id": {
          "title": "Topic Id",
          "type": "string"
        },
        "canonical_title": {
          "title": "Canonical Title",
          "type": "string"
        },
        "score": {
          "title": "Score",
          "type": "integer"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "topic_id",
        "canonical_title",
        "score",
        "reason"
      ],
      "title": "DiscardedTopic",
      "type": "object"
    },
    "ExperimentSelection": {
      "additionalProperties": false,
      "description": "The (at most one) practical-experiment suggestion, or a stated 'none'.",
      "properties": {
        "selection_rule": {
          "title": "Selection Rule",
          "type": "string"
        },
        "experiment": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExperimentSuggestion"
            },
            {
              "type": "null"
            }
          ]
        },
        "none_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "None Reason"
        }
      },
      "required": [
        "selection_rule",
        "experiment",
        "none_reason"
      ],
      "title": "ExperimentSelection",
      "type": "object"
    },
    "ExperimentSuggestion": {
      "additionalProperties": false,
      "description": "One locally-reproducible practical experiment derived from a topic.",
      "properties": {
        "topic_id": {
          "title": "Topic Id",
          "type": "string"
        },
        "canonical_title": {
          "title": "Canonical Title",
          "type": "string"
        },
        "rank": {
          "title": "Rank",
          "type": "integer"
        },
        "what_it_would_test": {
          "title": "What It Would Test",
          "type": "string"
        }
      },
      "required": [
        "topic_id",
        "canonical_title",
        "rank",
        "what_it_would_test"
      ],
      "title": "ExperimentSuggestion",
      "type": "object"
    },
    "LibraryMovement": {
      "additionalProperties": false,
      "description": "One topic's lifecycle movement in the persistent topic library (M6),\ne.g. newly seen, promoted from deferred, deferred, rejected, or gone\nstale -- with the reason for the movement.",
      "properties": {
        "topic_id": {
          "title": "Topic Id",
          "type": "string"
        },
        "canonical_title": {
          "title": "Canonical Title",
          "type": "string"
        },
        "movement": {
          "title": "Movement",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "topic_id",
        "canonical_title",
        "movement",
        "reason"
      ],
      "title": "LibraryMovement",
      "type": "object"
    },
    "LibraryMovementsSection": {
      "additionalProperties": false,
      "description": "Library movements for this week. ``deferred_note`` is populated (and\n``movements`` empty) when no library-update result is wired into this\nbrief -- e.g. a standalone M5 brief with no M6 library yet -- rather than\nsilently omitting the section.\n\nv0.2 additions (Opus orchestrator, Gate C, \u00a713; ADR 0004 D8): the\n``new``/``promoted``/``demoted``/``returning_from_deferred``/``stale``/\n``merged`` buckets mirror ``library.MovementsDocument``'s categories,\npopulated by ``library.library_movements_for_brief`` -- empty (never\n``None``) when no library-update result is wired in, same as\n``movements``/``deferred_note`` above.",
      "properties": {
        "movements": {
          "items": {
            "$ref": "#/$defs/LibraryMovement"
          },
          "title": "Movements",
          "type": "array"
        },
        "deferred_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deferred Note"
        },
        "new": {
          "items": {
            "$ref": "#/$defs/LibraryMovement"
          },
          "title": "New",
          "type": "array"
        },
        "promoted": {
          "items": {
            "$ref": "#/$defs/LibraryMovement"
          },
          "title": "Promoted",
          "type": "array"
        },
        "demoted": {
          "items": {
            "$ref": "#/$defs/LibraryMovement"
          },
          "title": "Demoted",
          "type": "array"
        },
        "returning_from_deferred": {
          "items": {
            "$ref": "#/$defs/LibraryMovement"
          },
          "title": "Returning From Deferred",
          "type": "array"
        },
        "stale": {
          "items": {
            "$ref": "#/$defs/LibraryMovement"
          },
          "title": "Stale",
          "type": "array"
        },
        "merged": {
          "items": {
            "$ref": "#/$defs/LibraryMovement"
          },
          "title": "Merged",
          "type": "array"
        }
      },
      "title": "LibraryMovementsSection",
      "type": "object"
    },
    "RadarItem": {
      "additionalProperties": false,
      "description": "One-paragraph \"Radar\" presentation of one Tier 3 topic.",
      "properties": {
        "rank": {
          "title": "Rank",
          "type": "integer"
        },
        "topic_id": {
          "title": "Topic Id",
          "type": "string"
        },
        "canonical_title": {
          "title": "Canonical Title",
          "type": "string"
        },
        "signal_paragraph": {
          "title": "Signal Paragraph",
          "type": "string"
        }
      },
      "required": [
        "rank",
        "topic_id",
        "canonical_title",
        "signal_paragraph"
      ],
      "title": "RadarItem",
      "type": "object"
    },
    "SecurityFlagSummary": {
      "additionalProperties": false,
      "description": "Gate E0 (E0.1), product ruling P1: the run-level security-flag\nreporting that must NEVER be per-topic.\n\n``hygiene_note`` covers every ``SecurityFlag`` other than the two\nADVERSARIAL ones (see ``intelligence.models.HYGIENE_SECURITY_FLAGS``) --\nmarkup neutralization, truncation, malformed encoding, unsupported MIME,\nredirect-chain length, batch-level duplicate/conflicting-date detection\n-- as a SINGLE count line over every item considered this run, never\nnamed per-topic (these fire on nearly every real HTML item and would\nbecome wallpaper).\n\n``tier3_and_discarded_adversarial_count``/``_note`` cover the narrower\ncase of an ADVERSARIAL flag (instruction_shaped_text/\ncredential_shaped_text) landing on a Tier 3 (Radar) or discarded topic:\nadversarial flags are named per-topic only for Tier 1/2 (see\n``Tier1LeanItem``/``Tier2Item``/``Tier1AppendixRecord``); for Tier 3 and\ndiscarded topics they are surfaced ONLY as a count here, never naming\nwhich topic, per product ruling P1 (\"Tier 3 / discarded: appendix count\nonly\").",
      "properties": {
        "hygiene_note": {
          "title": "Hygiene Note",
          "type": "string"
        },
        "tier3_and_discarded_adversarial_count": {
          "minimum": 0,
          "title": "Tier3 And Discarded Adversarial Count",
          "type": "integer"
        },
        "tier3_and_discarded_adversarial_note": {
          "title": "Tier3 And Discarded Adversarial Note",
          "type": "string"
        }
      },
      "required": [
        "hygiene_note",
        "tier3_and_discarded_adversarial_count",
        "tier3_and_discarded_adversarial_note"
      ],
      "title": "SecurityFlagSummary",
      "type": "object"
    },
    "StudyQueue": {
      "additionalProperties": false,
      "description": "One deep-study topic (optional) plus up to two light-study topics.",
      "properties": {
        "selection_rule": {
          "title": "Selection Rule",
          "type": "string"
        },
        "deep": {
          "anyOf": [
            {
              "$ref": "#/$defs/StudyTopicRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "deep_none_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Deep None Reason"
        },
        "light": {
          "items": {
            "$ref": "#/$defs/StudyTopicRef"
          },
          "title": "Light",
          "type": "array"
        },
        "light_none_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Light None Reason"
        }
      },
      "required": [
        "selection_rule",
        "deep",
        "deep_none_reason",
        "light",
        "light_none_reason"
      ],
      "title": "StudyQueue",
      "type": "object"
    },
    "StudyTopicRef": {
      "additionalProperties": false,
      "description": "A pointer to one topic selected into the study queue.",
      "properties": {
        "topic_id": {
          "title": "Topic Id",
          "type": "string"
        },
        "canonical_title": {
          "title": "Canonical Title",
          "type": "string"
        },
        "rank": {
          "title": "Rank",
          "type": "integer"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "topic_id",
        "canonical_title",
        "rank",
        "reason"
      ],
      "title": "StudyTopicRef",
      "type": "object"
    },
    "Tier1AppendixRecord": {
      "additionalProperties": false,
      "description": "The full record for one Tier 1 topic -- every fact the lean Tier 1\npresentation omits. Thirteen named fields (see\n``tests/test_intelligence_brief.py`` for the field-count assertion; was\ntwelve before Gate E0 added ``adversarial_security_flags`` below):\n``topic_id``, ``rank``, ``canonical_title``, ``score``, ``claim_class``,\n``claim_class_reason``, ``confidence``, ``confidence_reason``,\n``admission_reasons``, ``exclusion_reasons``, ``warnings``,\n``dimension_breakdown`` (one summary line per ``RankingBreakdown``\ndimension, so the full per-dimension detail is reachable without\nre-running the rubric), and ``adversarial_security_flags`` (Gate E0,\nE0.1, product ruling P1 -- a field distinct from ``warnings`` on\npurpose). ``tier1_admitted`` is deliberately not a fourteenth field:\nevery appendix record is for an admitted Tier 1 topic by construction.",
      "properties": {
        "topic_id": {
          "title": "Topic Id",
          "type": "string"
        },
        "rank": {
          "title": "Rank",
          "type": "integer"
        },
        "canonical_title": {
          "title": "Canonical Title",
          "type": "string"
        },
        "score": {
          "title": "Score",
          "type": "integer"
        },
        "claim_class": {
          "enum": [
            "fact",
            "hypothesis",
            "marketing"
          ],
          "title": "Claim Class",
          "type": "string"
        },
        "claim_class_reason": {
          "title": "Claim Class Reason",
          "type": "string"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "confidence_reason": {
          "title": "Confidence Reason",
          "type": "string"
        },
        "admission_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Admission Reasons",
          "type": "array"
        },
        "exclusion_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Exclusion Reasons",
          "type": "array"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "dimension_breakdown": {
          "items": {
            "type": "string"
          },
          "title": "Dimension Breakdown",
          "type": "array"
        },
        "adversarial_security_flags": {
          "items": {
            "type": "string"
          },
          "title": "Adversarial Security Flags",
          "type": "array"
        }
      },
      "required": [
        "topic_id",
        "rank",
        "canonical_title",
        "score",
        "claim_class",
        "claim_class_reason",
        "confidence",
        "confidence_reason",
        "admission_reasons",
        "exclusion_reasons",
        "warnings",
        "dimension_breakdown"
      ],
      "title": "Tier1AppendixRecord",
      "type": "object"
    },
    "Tier1LeanItem": {
      "additionalProperties": false,
      "description": "Lean, ~5-line Tier 1 (\"Must Understand\") presentation of one topic.\n\n``first_party_authoritative_note`` is populated (non-``None``) only when\nthis topic was admitted solely via the D1 exception (ADR 0004, Founder\nfinal decision Gate C): it states plainly that this is an uncorroborated\nfirst-party-authoritative source with no independent analysis. ``None``\nfor every topic admitted by the base Tier-1 rule.",
      "properties": {
        "rank": {
          "title": "Rank",
          "type": "integer"
        },
        "topic_id": {
          "title": "Topic Id",
          "type": "string"
        },
        "canonical_title": {
          "title": "Canonical Title",
          "type": "string"
        },
        "what_changed": {
          "title": "What Changed",
          "type": "string"
        },
        "why_it_matters": {
          "title": "Why It Matters",
          "type": "string"
        },
        "evidence_and_confidence": {
          "title": "Evidence And Confidence",
          "type": "string"
        },
        "first_party_authoritative_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "First Party Authoritative Note"
        },
        "recommended_action": {
          "enum": [
            "study",
            "read",
            "save",
            "monitor",
            "ignore"
          ],
          "title": "Recommended Action",
          "type": "string"
        },
        "recommended_action_reason": {
          "title": "Recommended Action Reason",
          "type": "string"
        },
        "score": {
          "title": "Score",
          "type": "integer"
        },
        "ranking_explanation": {
          "title": "Ranking Explanation",
          "type": "string"
        },
        "adversarial_security_flags": {
          "items": {
            "type": "string"
          },
          "title": "Adversarial Security Flags",
          "type": "array"
        }
      },
      "required": [
        "rank",
        "topic_id",
        "canonical_title",
        "what_changed",
        "why_it_matters",
        "evidence_and_confidence",
        "first_party_authoritative_note",
        "recommended_action",
        "recommended_action_reason",
        "score",
        "ranking_explanation"
      ],
      "title": "Tier1LeanItem",
      "type": "object"
    },
